# OpenPlag test environment
# Copy this file to .env and set any credentials needed for online tests.

# Optional local SearXNG endpoint used by --searxng.
OPENPLAG_SEARXNG=

# Optional API keys. Leave blank for unauthenticated/public test runs.
S2_API_KEY=
CORE_API_KEY=
MARGINALIA_API_KEY=

# Keep routine tests offline and deterministic. Set to 1 only for an
# explicitly requested online integration run.
OPENPLAG_TEST_ONLINE=0
