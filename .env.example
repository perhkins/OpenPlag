# Copy to .env and edit:  cp .env.example .env
# NEVER commit .env to GitHub (it holds secrets). It is already listed in .gitignore.

# Shared secret between the UI and the API. Generate one:  openssl rand -hex 24
OPENPLAG_API_KEY=change-me

# Password visitors must type to use the web page. REQUIRED for any public deployment,
# otherwise anyone on the internet can use (and overload) your server.
OPENPLAG_UI_PASSWORD=

# Your email, sent to free academic APIs (OpenAlex, Crossref) so they treat you as a polite client.
OPENPLAG_CONTACT_EMAIL=

# Production only: the web address people will visit, e.g. check.example.com
# or <server-ip>.sslip.io (e.g. 203.0.113.7.sslip.io). Leave as localhost for local use.
OPENPLAG_DOMAIN=localhost

# Limits and housekeeping (defaults shown)
OPENPLAG_WORKERS=2
OPENPLAG_MAX_UPLOAD_MB=15
OPENPLAG_RATE_LIMIT_PER_HOUR=30
OPENPLAG_RETENTION_DAYS=7

# Optional keys that switch on more sources (both free):
# CORE_API_KEY=
# S2_API_KEY=

# Heavy neural AI detector (needs requirements-ai.txt in the API image + >=8 GB RAM). Leave 0 at first.
OPENPLAG_NEURAL=0
